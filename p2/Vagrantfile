# -*- mode: ruby -*-
# vi: set ft=ruby :

# Debian 13 (trixie) : derniere version stable de la distribution (exigence du sujet).
BOX         = "bento/debian-13"

SERVER_NAME = "llarreyS"
SERVER_IP   = "192.168.56.110"

Vagrant.configure("2") do |config|
  config.vm.box = BOX
  config.vm.box_version = "202510.26.0"
  config.vm.boot_timeout = 900

  # Machine unique de la partie 2 : K3s en mode server.
  config.vm.define SERVER_NAME do |server|
    server.vm.hostname = SERVER_NAME
    server.vm.network "private_network", ip: SERVER_IP

    server.vm.provider "virtualbox" do |vb|
      vb.name   = SERVER_NAME
      vb.memory = 1024
      vb.cpus   = 1
      vb.customize ["setextradata", :id, "VBoxInternal/TM/TSCModeSwitchAllowed", "0"]
      # Clone lie : les machines partagent l'image de base au lieu d'en copier
      # une chacune. Environ 1 Go de disque economise par machine et un
      # `vagrant up` nettement plus court, ce qui compte sur un poste dont le
      # disque et la RAM sont deja contraints, et ou les parties sont relancees
      # plusieurs fois. Contrepartie : VirtualBox garde une VM de base
      # supplementaire, visible dans `VBoxManage list vms` mais jamais demarree.
      vb.linked_clone = true
    end

    # Les manifests sont lus depuis le dossier synchronise /vagrant/confs.
    server.vm.provision "shell",
      path: "scripts/install_k3s.sh",
      env: { "NODE_IP" => SERVER_IP }

    server.vm.provision "shell",
      path: "scripts/setup_apps.sh",
      env: { "NODE_IP" => SERVER_IP }
  end
end
